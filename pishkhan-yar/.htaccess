# PishkhanYar Apache Configuration
Options -Indexes
Options +FollowSymLinks

# PHP Settings Override
php_flag display_errors Off
php_value session.cookie_httponly 1
php_value default_charset UTF-8

# Rewrite Engine
RewriteEngine On
RewriteBase /

# Force trailing slash removal for cleanliness
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php [L,QSA]

# Security: Deny access to sensitive files/dirs
<FilesMatch "^(\.env|\.git|composer\.(json|lock)|package\.json)$">
    Require all denied
</FilesMatch>

# Deny access to database directory (via FilesMatch - DirectoryMatch not allowed in .htaccess)
<FilesMatch "^(schema\.sql|.*\.sqlite)$">
    Require all denied
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Cache static assets
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=86400, public"
    </FilesMatch>

    # No cache for PHP files
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# Compress text responses
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json text/xml
</IfModule>

# Default charset
AddDefaultCharset UTF-8
